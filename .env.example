# ====================================================
# Antigravity Telegram Bot Configuration
# ====================================================

# 1. Your Telegram Bot Token from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Allowed Telegram Numerical User ID(s)
# Example: 123456789 (comma-separated for multiple: 123456789,987654321)
# NOTE: You can leave this blank on first run!
# When you message /start to the bot, it will give you a 1-click /claim command to pair automatically.
ALLOWED_TELEGRAM_USER_IDS=

# 3. Default workspace folder where Antigravity executes commands
# Defaults to current directory if left blank
DEFAULT_WORKSPACE=.

# 4. Path to Antigravity CLI executable (agy.exe)
# Optional: Leave blank for auto-detection in PATH or %LOCALAPPDATA%\agy\bin\agy.exe
AGY_PATH=
